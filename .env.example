# mootech-be — environment contract (MASKED EXAMPLE)
# Real values live ONLY in the Render dashboard (sync: false). Never commit real secrets.
# See FE repo MUMATE-GITHUB-FLOW.md §5 (Secret Hygiene).

# --- App ---
ENVIRONMENT=development
APP_DEBUG=false
APP_PORT=3000
PORT=3000
CORS_ORIGINS=http://localhost:3000
PV_TIMEOUT=30000
MIGRATION_ENABLED=false

# --- Database (Supabase Postgres) ---
DB_TYPE=postgres
DB_HOST=<db-host>
DB_PORT=5432
DB_USERNAME=<db-user>
DB_PASSWORD=<REDACTED>
DB_DATABASE=<db-name>
DB_SYNCHRONIZE=false

# --- Supabase Storage ---
SUPABASE_PROJECT_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<REDACTED>
SUPABASE_STORAGE_BUCKET=<bucket>
SUPABASE_SIGNED_URL_TIMEOUT=3600

# --- Payment (Omise) ---
OMISE_PUBLIC_KEY=pkey_test_***
OMISE_SECRET_KEY=skey_test_***
OMISE_WEBHOOK_SECRET=<REDACTED>
OMISE_RETURN_URI=https://<frontend>/payment/callback

# --- LINE ---
LINE_HOST=https://api.line.me
LINE_TOKEN=<REDACTED>

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.***
SENDGRID_FROM_EMAIL=no-reply@<domain>
SENDGRID_FROM_NAME=MuMate

# --- SMS (8x8) ---
SMS_8X8_HOST=https://sms.8x8.com
SMS_8X8_TOKEN=<REDACTED>
SMS_8X8_TOPIC=<topic>
SMS_8X8_ENCODING=AUTO

# --- AI (Dify) ---
DIFY_API_URL=https://<dify-host>/v1
DIFY_API_KEY=<REDACTED>

# --- AWS S3 (legacy — slated for removal, see go-live checklist) ---
AWS_ACCESS_KEY_ID=<REDACTED>
AWS_SECRET_ACCESS_KEY=<REDACTED>
AWS_S3_ROOT_BUCKET=<bucket>
AWS_S3_THUMB_ROOT_BUCKET=<bucket>
AWS_S3_SIGNED_URL_TIMEOUT=3600
