# Mumate prod monitor — env reference (DOCUMENTATION ONLY)
#
# The monitor reads these from the gitignored `projects/mootech-be/.env.local`
# (NOT from this file). Add the keys below to .env.local with real values.
# Never commit real secrets. This example carries placeholders only.

# Discord webhook for prod alert cards (required)
SERVER_MONITOR_DISCORD_WEB_HOOK=https://discord.com/api/webhooks/XXXX/YYYY

# Render API key — read-only metrics access (required)
SERVER_MONITOR_RENDER_API_KEY=rnd_XXXXXXXXXXXXXXXX

# Render service id to read CPU/mem from (optional — defaults to the Mumate BE)
# SERVER_MONITOR_RENDER_SERVICE_ID=srv-d8nc4j8k1i2s73d7e030

# Hourly "all good" heartbeat card: on | off (optional — default off)
# SERVER_MONITOR_HEARTBEAT=off
