#!/usr/bin/env bash
# pre-push — TWO guards, deliberately with DIFFERENT failure directions (see §fail direction below).
#
#   guard A (branch)  refuse an ACCIDENTAL push straight to this repo's protected (default) branch.
#   guard B (gate)    refuse a push whose `lint` or `test` is not green on THIS machine.  (#320)
#
# This file is a sibling of mootech-fe/.githooks/pre-push — same shape on purpose, so a reviewer can diff
# the two and see that only the cost note differs. Keep them in step.
#
# The protected branch is READ FROM GIT, never hardcoded (from the remote's HEAD symref), so the same hook
# is correct in every repo.
#
# HONEST SCOPE: this catches "เผลอ push main" and "เผลอ push ของที่ยังไม่เขียว". It is NOT a hard block —
# `git push --no-verify` skips every hook. It is the "ดัก" layer, not "บังคับ".
#
# WHY THE GATE LIVES HERE AND NOT IN CI (#318, ฟีม-decided 2026-08-18):
#   `ci.yml` is being retired — merge into main = production deploy (Render autoDeploy) and GitHub Actions
#   minutes are paid. lint + test run here on every push: measured 2026-08-18 on `aad9e1a`,
#   lint 10s + test 102s ≈ 112s. That is the slowest gate of the two repos and ฟีม accepted it explicitly
#   rather than drop `test` to a later stage — `test` is the thing we decided to trust instead of harnesses.
#   ⚠️ If anyone starts reaching for `--no-verify`, that is the signal this cost is too high: say so in
#   mojisejr/mootech-fe#320 instead of quietly bypassing.
#   `build` (nest build, 5s here) is NOT in the hook only to stay symmetric with mootech-fe, where build
#   costs 41s-408s depending on .next cache (10x spread, measured 5 runs 2026-08-18). It is checked once
#   before opening the PR, with its output pasted into the PR body. The reason build is excluded there is
#   the VARIANCE, not the average — an unpredictable wait teaches people to reach for --no-verify.
#
# git invokes: pre-push <remote-name> <remote-url>, with stdin lines:
#   <local ref> SP <local oid> SP <remote ref> SP <remote oid> LF
set -euo pipefail

remote="${1:-origin}"
ZERO_OID_RE='^0*$'

# ── guard A · protected branch ────────────────────────────────────────────────────────────────
protected="$(git symbolic-ref --quiet --short "refs/remotes/${remote}/HEAD" 2>/dev/null | sed "s#^${remote}/##" || true)"
if [ -z "${protected}" ]; then
  # Detection failed → guard A FAILS OPEN (a ดัก must not block legit work when it can't tell).
  # 🔴 It must NOT `exit 0` here. That returns from the whole script and takes guard B — which fails
  #    CLOSED on purpose — down with it. ตู๋ proved it (mojisejr/mootech-fe#325, 2026-08-18): with
  #    origin/HEAD removed and lint red, the push SUCCEEDED and the hard gate never ran, while the message
  #    said "guard skipped" (singular) — so the §fail direction paragraph below described something the
  #    code did not do. Leaving `protected` empty and guarding the comparison skips ONLY guard A.
  echo "pre-push: cannot determine ${remote}'s default branch (is ${remote}/HEAD set?) — branch guard skipped (the lint/test gate still runs)." >&2
fi

# has_content = at least one ref actually SENDS commits up. Verified empirically 2026-08-18 in a throwaway
# repo, because guessing this wrong wastes ~112s on pushes that carry no code:
#   push a branch      → localref='refs/heads/feat/x'  localoid=<sha>
#   push --delete      → localref='(delete)'           localoid=000…0   ⇒ skip the gate
#   already up-to-date → git fires the hook with ZERO stdin lines       ⇒ skip the gate
blocked=0
has_content=0
while read -r _localref localoid remoteref _remoteoid; do
  [ -z "${remoteref:-}" ] && continue
  if ! [[ "${localoid}" =~ ${ZERO_OID_RE} ]]; then
    has_content=1
  fi
  branch="${remoteref#refs/heads/}"
  if [ -n "${protected}" ] && [ "${branch}" = "${protected}" ]; then
    blocked=1
  fi
done

if [ "${blocked}" -eq 1 ]; then
  cat >&2 <<MSG

  ✋ pre-push blocked: you are pushing directly to '${protected}' (this repo's protected branch).

  Why this is blocked:
    • merge is ฟีม's decision — even a one-line doc/config change goes through a PR
    • main = production deploy (Render autoDeploy); a direct push deploys without anyone reviewing it

  Do this instead:
    git switch -c feat/your-change            # put your commit(s) on a branch
    git push -u ${remote} feat/your-change    # push the branch (this is allowed)
    gh pr create                              # open a PR → ฟีม merges

  (This is a guard, not a wall: 'git push --no-verify' bypasses it. Follow the PR rule anyway.)

MSG
  exit 1
fi

# ── guard B · hard gate (lint + test) ─────────────────────────────────────────────────────────
if [ "${has_content}" -eq 0 ]; then
  echo "pre-push: nothing being sent (delete / already up-to-date) — hard gate skipped." >&2
  exit 0
fi

# §fail direction — guard A fails OPEN, guard B fails CLOSED. This asymmetry is deliberate:
#   guard A protects against a MISTAKE. If it cannot tell whether you are making that mistake, blocking
#     you would be worse than letting you through — you still have the PR rule.
#   guard B asserts a FACT ("lint and test are green here"). If it cannot run the check, it has no fact
#     to assert. Passing would announce green without anything having been measured — exactly the shape
#     this whole issue (#318) exists to remove.
# ⇒ do NOT "make the hook consistent" by aligning these two. They answer different questions.
die() { printf '\n  ✋ pre-push blocked: %s\n\n' "$1" >&2; exit 1; }

command -v npm >/dev/null 2>&1 \
  || die "'npm' is not on PATH, so lint/test could not run. Not passing a check that never happened.
     (GUI git clients often have a smaller PATH than your shell — launch from a terminal, or fix the client's PATH.)"

# ⚠️ `npm run lint` here MUST be the no-fix form. Until #320 the script carried `--fix`, which REWRITES
# your source while claiming to check it — a gate that edits the thing it is measuring. `lint` is now the
# check and `lint:fix` is the rewriter; see package.json.
echo "pre-push: hard gate → npm run lint" >&2
npm run lint \
  || die "'npm run lint' failed (or the 'lint' script is missing). Fix it, then push again."

echo "pre-push: hard gate → npm test  (jest ≈ 100s here, this is the slow one)" >&2
npm test \
  || die "'npm test' failed (or the 'test' script is missing). Fix it, then push again."

echo "pre-push: hard gate green (lint + test). 'npm run build' is still yours to run before opening the PR." >&2
exit 0
